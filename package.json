{
  "name": "louper-v3",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "bun --bun vite dev",
    "build": "svelte-kit sync && vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "prettier --check . && eslint .",
    "check:content": "node scripts/check-content.js",
    "format": "prettier --write .",
    "migrate": "bun run migrate:validate && bun run migrate:backup && bun run migrate:upgrade-core && bun run migrate:svelte && bun run migrate:update-deps && bun run migrate:regenerate-components && bun run migrate:test",
    "migrate:validate": "bun run scripts/validate-migration.js",
    "migrate:backup": "rsync -a --exclude='.backup' --exclude='node_modules' --exclude='.git' ./ .backup/pre-migration-$(date +%Y%m%d-%H%M%S)/",
    "migrate:upgrade-core": "bun install svelte@^5.43.3 @sveltejs/kit@^2.48.4 @sveltejs/vite-plugin-svelte@^6.2.1 vite@^5.4.21 -D",
    "migrate:svelte": "bun x sv migrate svelte-5",
    "migrate:update-deps": "bun install bits-ui@^2.14.2 @lucide/svelte@latest tailwindcss-animate -D && bun remove cmdk-sv lucide-svelte radix-icons-svelte",
    "migrate:regenerate-components": "bun x shadcn-svelte@latest add --all --overwrite",
    "migrate:test": "bun run check && bun --bun run build",
    "migrate:rollback": "echo 'Rolling back migration...' && rm -rf node_modules bun.lock && rsync -a .backup/pre-migration-latest/* . && bun install"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@exodus/schemasafe": "^1.3.0",
    "@sinclair/typebox": "^0.34.52",
    "@sveltejs/adapter-auto": "^7.0.1",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tanstack/table-core": "^8.21.3",
    "@typeschema/class-validator": "^0.3.0",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "@vinejs/vine": "^4.4.0",
    "arktype": "^2.2.3",
    "autoprefixer": "^10.6.0",
    "bun-types": "^1.4.2",
    "class-validator": "^0.15.1",
    "drizzle-kit": "^0.31.10",
    "embla-carousel-svelte": "8.6.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.23.0",
    "formsnap": "2.0.1",
    "globals": "^17.12.0",
    "joi": "^18.2.9",
    "mode-watcher": "^1.1.0",
    "paneforge": "^1.0.2",
    "postcss": "^8.5.28",
    "postcss-load-config": "^6.0.1",
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^4.1.1",
    "superstruct": "^2.0.2",
    "svelte": "^5.57.0",
    "svelte-adapter-bun": "^1.0.1",
    "svelte-check": "^4.7.6",
    "svelte-sonner": "^1.2.1",
    "sveltekit-superforms": "^2.30.2",
    "tailwindcss": "^3.4.19",
    "tailwindcss-animate": "^1.0.7",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "valibot": "^1.5.0",
    "vaul-svelte": "1.0.0-next.7",
    "vite": "^8.3.0",
    "vite-plugin-node-polyfills": "^0.28.0",
    "yup": "^1.7.1",
    "zod": "^4.6.5"
  },
  "type": "module",
  "overrides": {
    "wagmi": "^2.19.5"
  },
  "dependencies": {
    "@lucide/svelte": "^1.46.0",
    "@safe-global/safe-apps-sdk": "^9.1.0",
    "@wagmi/connectors": "^6.2.0",
    "@wagmi/core": "^2.22.1",
    "@web3modal/wagmi": "^5.1.11",
    "bits-ui": "^2.19.2",
    "clsx": "^2.1.1",
    "consola": "^3.4.2",
    "drizzle-orm": "^0.45.2",
    "tailwind-merge": "^3.7.0",
    "tailwind-variants": "^3.3.1",
    "viem": "^2.56.5"
  },
  "trustedDependencies": [
    "@sveltejs/kit",
    "svelte-preprocess",
    "utf-8-validate"
  ]
}
