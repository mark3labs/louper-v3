# Build environment: "production" enables the analytics + AdSense loaders
# (see src/hooks.server.ts). Anything else disables them for local dev.
PUBLIC_BUILD_ENV=development

# Google AdSense publisher ID (ca-pub-XXXXXXXXXXXXXXXX).
# Must match the `google.com, pub-...` line in static/ads.txt.
PUBLIC_ADSENSE_CLIENT=ca-pub-0000000000000000

# AdSense ad unit ID (the `data-ad-slot` number from your AdSense dashboard).
#
# Leave this UNSET until you have a real, approved ad unit. An unset or
# placeholder value causes the ad markup to be skipped entirely rather than
# rendering an empty box labelled "Advertisement" -- which is itself a policy
# problem ("Google-served ads on screens without publisher-content").
#
# Ads are additionally suppressed on error pages, loading screens and thin
# utility pages. See src/lib/ads.ts for the full policy.
PUBLIC_ADSENSE_SLOT_CONTENT=
