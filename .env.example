# Build environment: "production" enables the analytics + AdSense loaders
# (see src/hooks.server.ts). Anything else disables them for local dev.
PUBLIC_BUILD_ENV=development

# ---------------------------------------------------------------------------
# AdSense configuration lives in SOURCE, not here.
#
# The publisher ID and ad unit IDs are public values (they are rendered into
# every page and committed in static/ads.txt), so they are constants in
# src/lib/ads.ts:
#
#   ADSENSE_CLIENT = 'ca-pub-...'   <- publisher ID, kept in sync with ads.txt
#   AD_SLOTS       = ['...']        <- ad unit IDs; replace the placeholder to
#                                      switch ads on
#
# A production deployment therefore needs NO ad configuration at all.
#
# The variables below are optional overrides, useful only for testing against
# a different AdSense account without editing source. Leave them unset in
# normal operation.
# ---------------------------------------------------------------------------

# PUBLIC_ADSENSE_CLIENT=ca-pub-0000000000000000
# PUBLIC_ADSENSE_SLOT_CONTENT=1234567890
